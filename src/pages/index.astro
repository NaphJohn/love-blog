---
import SiteHeader from '../components/SiteHeader.astro';
import TodayBadge from '../components/TodayBadge.astro';
const base = import.meta.env.BASE_URL;
const chapters = [
  { slug: 'eq1-self-awareness', title: '（一）自我觉察与内在框架：先搞定自己，再谈关系', desc: '课题分离、依恋类型、三个日常可练的稳定动作。', date: '2026-08-01', free: true },
  { slug: 'eq2-attraction', title: '（二）吸引力与初识：吸引力不是天赋，是可习得的行为模式', desc: '第一印象、可得性、投资与真诚。', date: '2026-08-01', free: true },
  { slug: 'eq3-gender-differences', title: '（三）两性沟通差异：冲突不是谁对谁错，是规则不同', desc: '把"听"与"解决"的差异变成协作。', date: '2026-08-01', free: true },
  { slug: 'eq4-nvc-crucial', title: '（四）非暴力沟通与关键对话：把冲突变成共识', desc: '观察-感受-需要-请求四步 + 关键对话。', date: '2026-08-01', free: false },
  { slug: 'eq5-win-favor', title: '（五）赢得好感与深度连接：让人"跟你在一起变得更好"', desc: '具体赞美、适度脆弱、共同意义。', date: '2026-08-01', free: false },
  { slug: 'eq6-influence-relationship', title: '（六）影响力与长期关系经营：用真诚被更好地接收', desc: '长期经营、非操控的影响力。', date: '2026-08-01', free: false },
  { slug: 'eq7-zhoumo-breakout', title: '（七）周末破圈实战：中科路排期、认识女生 N 种途径与话费分档', desc: '周五 18:00 到周日落地排期、12 种途径、4 档话费。', date: '2026-08-12', free: true },
];
const freeCount = chapters.filter((c) => c.free).length;
---
<SiteHeader lang="zh" altLang="en" altHref="/en/" />
<main class="course">
  <p class="kicker">✦ 情商 · 亲密关系 · 沟通</p>
  <h1>心动解码 · 情商恋爱手记</h1>
  <TodayBadge />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <p class="sub">一套关于「搞定自己、被真诚看见、懂差异、化冲突、深连接、长经营」的情商恋爱实战笔记。前 3 节免费，后续欢迎请作者喝杯咖啡解锁。</p>
  <p class="rule">前 <b>{freeCount}</b> 节免费阅读；后续章节欢迎<b>请作者喝杯咖啡 ☕️</b>（最低 ¥1，上不封顶）解锁全部内容。作者本人免付费。</p>

  <ol class="ch-list">
    {chapters.map((c, i) => (
      <li class={c.free ? 'free' : 'paid'}>
        <span class="no">{(i + 1).toString().padStart(2, '0')}</span>
        <a href={`${base}blog/${c.slug}`} class="title">{c.title}</a>
        {c.free ? <span class="tag free">免费</span> : <span class="tag paid">☕️ 请作者喝咖啡</span>}
        <p class="desc">{c.desc}</p>
      </li>
    ))}
  </ol>

  <section class="labs">
    <p class="labs-kicker">✦ 互动实验室</p>
    <a class="lab lab-math" href={`${base}love-math/`}>
      <span class="lab-ico">🧩</span>
      <span class="lab-body">
        <span class="lab-t">爱情数学：九章 × 十二个模型</span>
        <span class="lab-d">把《爱情数学》全书拆成能算、能验证的 12 个模型（37% 法则 = 1/e、塔尖拥堵、稳定匹配、条件连乘、长尾均值陷阱……），每个都带「能算出来的数 / 怎么用 / 什么时候别用 / 是否有效」。<b>可点选 · 全部数字现算</b></span>
      </span>
      <span class="lab-go">进入 →</span>
    </a>
    <a class="lab lab-type" href={`${base}love-type/`}>
      <span class="lab-ico">🧬</span>
      <span class="lab-body">
        <span class="lab-t">四型人格测试：你是哪一型？</span>
        <span class="lab-d">探索者（多巴胺）/ 建设者（血清素）/ 主导者（睾酮）/ 协商者（雌激素）——20 道情境题即时出结果，附四型速查表、约会时如何识别、关系里的坑，以及每型该用哪个模型。<b>答题 · 即时出结果</b></span>
      </span>
      <span class="lab-go">去测试 →</span>
    </a>
    <a class="lab lab-pers" href={`${base}love-personality/`}>
      <span class="lab-ico">📐</span>
      <span class="lab-body">
        <span class="lab-t">人格三张尺：大五 · 16 型 · 四型</span>
        <span class="lab-d">三套框架一起做、互相对照：<b>大五（重测信度 &gt; 0.8，最准的那个）</b>、16 型（四轴连续分数，不贴死标签）、四型（约会向速测）。含「这三张尺的准度不一样」效度对照表，以及四型 ↔ 大五 ↔ 16 型的对应关系。<b>可选择 · 结果自动对照</b></span>
      </span>
      <span class="lab-go">三张尺 →</span>
    </a>
  </section>

  <section class="engage">
    <p class="engage-tip">觉得有用？欢迎请作者喝杯咖啡 ☕️</p>
    <div class="reward">
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/alipay.png`} alt="支付宝收款码" loading="lazy" /></div>
        <p>支付宝</p>
      </div>
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/wechat.png`} alt="微信收款码" loading="lazy" /></div>
        <p>微信</p>
      </div>
    </div>
  </section>

  <p class="foot-note">⚠️ 本站内容仅供个人成长参考，不构成心理咨询或专业建议。</p>
</main>

<style is:global>
  :root { --bg-url: url('/love-blog/24solar-bg.png'); }
  .course { max-width: 760px; margin: 0 auto; padding: 48px 16px 40px; }
  .kicker { color: var(--accent); letter-spacing: 2px; font-size: 13px; margin: 0 0 8px; }
  .course h1 { font-size: 32px; margin: 0 0 10px; letter-spacing: 1px; }
  .sub { color: var(--muted); font-size: 16px; line-height: 1.8; margin: 0 0 8px; }
  .rule { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; font-size: 14px; color: var(--fg); }
  .rule b { color: var(--accent); }
  .ch-list { list-style: none; padding: 0; margin: 22px 0 0; }
  .ch-list li { padding: 16px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ch-list li.paid { border-left: 4px solid #d63031; }
  .ch-list li.free { border-left: 4px solid var(--accent); }
  .no { color: var(--accent); font-weight: 800; font-size: 15px; }
  .title { font-weight: 600; color: var(--fg); text-decoration: none; font-size: 17px; }
  .tag { font-size: 12px; padding: 1px 9px; border-radius: 999px; font-weight: 600; }
  .tag.free { background: rgba(224,69,123,0.10); color: var(--accent); }
  .tag.paid { background: rgba(214,48,49,0.12); color: #d63031; }
  .desc { width: 100%; color: var(--muted); font-size: 13px; margin: 4px 0 0; }
  .engage { margin-top: 30px; padding: 22px; border: 1px solid var(--border); border-radius: 12px; background: var(--code-bg); text-align: center; }

  /* 互动实验室入口 */
  .labs { margin-top: 30px; }
  .labs-kicker { color: var(--accent); letter-spacing: 2px; font-size: 13px; margin: 0 0 10px; }
  .lab { display: flex; align-items: center; gap: 14px; padding: 16px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 12px; text-decoration: none; color: var(--fg); transition: .16s; }
  .lab:hover { transform: translateY(-2px); border-color: var(--accent); }
  .lab-math { border-left: 4px solid #6366f1; }
  .lab-type { border-left: 4px solid var(--accent); }
  .lab-pers { border-left: 4px solid #16a34a; }
  .lab-ico { font-size: 28px; flex: none; }
  .lab-body { flex: 1; display: flex; flex-direction: column; gap: 3px; }
  .lab-t { font-weight: 700; font-size: 17px; }
  .lab-d { color: var(--muted); font-size: 13px; line-height: 1.7; }
  .lab-d b { color: var(--accent); font-weight: 700; }
  .lab-go { flex: none; color: var(--accent); font-size: 13.5px; font-weight: 600; }
  @media (max-width: 560px) { .lab-go { display: none; } }
  .engage-tip { color: var(--fg); font-size: 15px; margin: 0 0 14px; }
  .reward { display: flex; gap: 24px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
  .reward-col { text-align: center; }
  .reward-qr { width: 120px; height: 120px; border: 1px solid var(--border); border-radius: 8px; display: flex; align-items: center; justify-content: center; background: var(--code-bg); overflow: hidden; }
  .reward-qr img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .reward-col p { margin: 8px 0 0; font-size: 14px; color: var(--fg); }
  .foot-note { color: var(--muted); font-size: 13px; margin-top: 28px; text-align: center; }
  /* 二十四节气新中式插画全局背景 */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: var(--bg-url);
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    opacity: 0.13;
    z-index: -1;
    pointer-events: none;
    transition: opacity .25s ease;
  }
  :root[data-theme="dark"] body::before { opacity: 0.08; }
</style>
