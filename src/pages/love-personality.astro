---
import SiteHeader from '../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;

// ═══════════════════════════════════════════════════════════
// 只有 4 类。不是因为它最准——三套常见框架里它精度最低——
// 而是因为它是唯一直接给出「约会时如何识别 / 与谁最搭 / 该用哪个模型」的。
// 大五更准但只给剖面，16 型有词汇但格子没证据。所以本站主类型用它。
// ═══════════════════════════════════════════════════════════

const types = [
  {
    id: 'E', emoji: '🎢', name: '探索者', en: 'Explorer', chem: '多巴胺高', color: '#f59e0b',
    traits: '好奇、爱冒险、说走就走、精力旺、怕无聊、爱新鲜感',
    spot: '聊旅行 / 新店 / 极限运动眼睛发光；日程常「还没想好」；口语多「好玩、刺激、下次试试」',
    good: '带得动场子、不怕陌生场合、能给关系注入新鲜感、恢复力强',
    trap: '新鲜感一退就想跑；把「关系」也当成一个待体验的项目；承诺偏慢，容易让对方没有安全感',
    match: '和「建设者」互补最稳（你负责带节奏，他负责兜底）；和同为探索者的人一开始最爽，但两个人都不管家时容易散',
    use: '模型 1：你天生不想「定下来」，所以要反着用——先给自己划一个观察期比例（比如未来 10 个接触对象里的前 3–4 个），过了这段就真的开始挑「比之前都好」的那个，而不是永远在观察。模型 2：你素材最多，把「说走就走的旅行」写成 3 个只有你会写的具体片段，比「热爱自由」强 7 倍。',
  },
  {
    id: 'B', emoji: '🏡', name: '建设者', en: 'Builder', chem: '血清素高', color: '#16a34a',
    traits: '沉稳、守序、重家庭与朋友、做事有计划、社交圆融、恋旧',
    spot: '聊家人 / 老朋友 / 固定习惯多；守时；喜欢「每年都去同一个地方」这种叙事',
    good: '可预期、让人安心、长期关系里最耐用的一型；社交圆融，不容易得罪人',
    trap: '太早把关系「制度化」会劝退探索者型的人；对新东西的容忍度低，容易把「不同」误判成「不合适」',
    match: '和「协商者」最顺（都重关系和谐）；和「探索者」互补——但你要接受他的日程永远「还没想好」',
    use: '模型 3：你的稳定感主要来自相似度，所以把「不能让」的 3 条底线写下来当筛子，别指望「磨合磨合就行」（Gottman：69% 是永久性问题）。模型 12b：你有求稳倾向，但别用「平均值」备资源——请 60 人、到场率 90%，按 54 人订桌有一半概率不够坐，要按 58 人订。模型 8：你容易坐在「被动接受安排」那一侧，记得你也该主动提。',
  },
  {
    id: 'D', emoji: '🎯', name: '主导者', en: 'Director', chem: '睾酮高', color: '#dc2626',
    traits: '直接、果断、竞争心强、重目标与效率、就事论事、感情表达克制',
    spot: '聊天像开会：直给结论、爱辩论、问「所以呢 / 然后呢」；约会倾向安排高效行程',
    good: '决断快、能扛事、目标感强；在关系里不拖泥带水，问题解决效率高',
    trap: '把伴侣当队友而不是当人；「高效行程」会让协商者觉得没被听见；一生气就上结论，容易把协调问题打成胜负问题',
    match: '和「协商者」互补最好（你做决定，他护关系）；和另一个主导者在一起，容易变成两个人在争方向盘',
    use: '模型 8：你本来就敢提，但要区分「提出」和「纠缠」——提一次、拿到明确答复就完成，别反复施压。模型 5：你最容易犯的错是「追 Top 1%」，数学上在任何自身水平下都不占优；提升自己（x）永远比抬高目标（y）划算。模型 4：别把关系当项目管——冷战是协调问题不是胜负问题，约定一个「这周轮到谁先让」的外部规则比讲道理有用。',
  },
  {
    id: 'N', emoji: '🕊️', name: '协商者', en: 'Negotiator', chem: '雌激素高', color: '#6366f1',
    traits: '共情力强、语言流利、重关系和谐、直觉敏锐、看大局、怕冲突',
    spot: '擅长追问你的感受；说话留余地；记得你上次提过的细节；回避正面表态',
    good: '共情与表达是天赋；能长期把关系的温度维持住；最擅长「让人愿意说真话」',
    trap: '为了不冲突而不敢设条件、不敢表态，最后自己憋着；容易一直当「接受安排」的一方，还觉得自己没有选择权',
    match: '和「主导者」最互补（他推、你稳）；和「建设者」同频最舒服；和同为协商者的人相处极顺，但可能谁都不肯把话讲死',
    use: '模型 9：你最舍不得松的其实是「有眼缘 / 聊得来」这类感觉条件——把它按「放开能多多少人」排序，先松最前面那条（各 20 倍）。模型 4：你太怕冲突，容易一直让步；正确做法不是「更能忍」，而是事先约定「谁先让」的外部机制（轮流先退一步，收益 +1.003/期、冷战清零）。模型 8：记住你也该是提议方——被动方平均落到第 35.6 志愿，主动方是第 5.7 志愿。',
  },
];

// ── 20 题 · 5 点量表（每型 5 题）──
const f4 = [
  { p: 'E', t: '我喜欢新鲜刺激，一成不变会让我坐不住。' },
  { p: 'E', t: '我常常说走就走，计划临时改也无所谓。' },
  { p: 'E', t: '旅行对我来说，最好的部分是「还没想好去哪儿」。' },
  { p: 'E', t: '我很容易对新事物着迷，也很容易腻。' },
  { p: 'E', t: '我精力旺盛，闲下来反而难受。' },

  { p: 'B', t: '我喜欢固定的节奏和熟悉的地方。' },
  { p: 'B', t: '我会提前把行程安排清楚。' },
  { p: 'B', t: '家人和老朋友对我特别重要。' },
  { p: 'B', t: '我守时，也希望别人守时。' },
  { p: 'B', t: '规则和秩序让我安心。' },

  { p: 'D', t: '我说话直接，不太喜欢绕弯子。' },
  { p: 'D', t: '有分歧时我会据理力争。' },
  { p: 'D', t: '我习惯快速做决定，然后往前推。' },
  { p: 'D', t: '我看重效率，不喜欢拖泥带水。' },
  { p: 'D', t: '我不太习惯把感情挂在嘴上。' },

  { p: 'N', t: '我很在意别人的感受，也容易察觉气氛变化。' },
  { p: 'N', t: '我说话会留余地，尽量不把关系弄僵。' },
  { p: 'N', t: '我常常在别人说出口之前，就知道他不太开心。' },
  { p: 'N', t: '我记得别人提过的那些小细节。' },
  { p: 'N', t: '我讨厌正面冲突，宁愿自己先让一步。' },
];

// ── 如果你熟悉大五 / MBTI，可以这么换算（模态对应，不是等价）──
const mapping = [
  { f4: '🎢 探索者', b5: '高开放性 · 中高外倾', t16: 'ENFP / ENTP', note: '都指向「被新鲜感驱动」；但探索者不必然外倾——也有安静的 INTP 型探索者。' },
  { f4: '🏡 建设者', b5: '高尽责性 · 中低开放性', t16: 'ISTJ / ISFJ / ESTJ', note: '都指向「稳定与秩序」；这是三套框架里对应最稳的一组。' },
  { f4: '🎯 主导者', b5: '低宜人性 · 高外倾或高支配', t16: 'ENTJ / ESTJ / INTJ', note: '都指向「直接、要结果」；但低宜人性 ≠ 冷血，只是不靠迁就维持关系。' },
  { f4: '🕊️ 协商者', b5: '高宜人性 · 高开放性', t16: 'ENFJ / INFP / INFJ', note: '都指向「共情与语言能力」；协商者是最不需要外倾的一型。' },
];
---

<SiteHeader lang="zh" series="心动解码" />
<main class="pp">
  <p class="kicker">✦ 四型人格 · 20 题 · 连续分数</p>
  <h1>四型人格测试：你是哪一型？</h1>
  <p class="meta">只有 <b>4 类</b>：探索者（多巴胺）· 建设者（血清素）· 主导者（睾酮）· 协商者（雌激素）。
    每题按「同意程度」打分，所以结果是<b>四条连续分数</b>而不是一个标签——你大概率是「某型为主 + 某型为辅」，这本来就更接近真实情况。</p>

  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>

  <!-- ══ ① 四型速查 ══ -->
  <h2 class="sub-h">先看：四型速查表</h2>
  <p class="plain">点一张卡展开详情。如果你已经大概知道自己是哪一型，可以跳过下面 20 题，直接看卡里的「该用哪些模型」。</p>
  <div class="tcards" id="tcards">
    {types.map((t) => (
      <button class="tcard" type="button" data-type={t.id} style={`--c:${t.color}`}>
        <span class="tc-emoji">{t.emoji}</span>
        <span class="tc-body">
          <span class="tc-name">{t.name} <small>{t.en}</small></span>
          <span class="tc-chem">{t.chem}</span>
          <span class="tc-traits">{t.traits}</span>
        </span>
        <span class="tc-go">展开 ↓</span>
      </button>
    ))}
  </div>
  {types.map((t) => (
    <div class="tpane" data-type={t.id} hidden style={`--c:${t.color}`}>
      <div class="tp-head">
        <span class="tp-emoji">{t.emoji}</span>
        <span><b>{t.name}</b> <small>{t.en}</small></span>
        <span class="tp-chem">{t.chem}</span>
      </div>
      <div class="tp-grid">
        <div class="tp-cell"><h4>典型特质</h4><p>{t.traits}</p></div>
        <div class="tp-cell tp-spot"><h4>约会时如何识别</h4><p>{t.spot}</p></div>
        <div class="tp-cell tp-good"><h4>优势</h4><p>{t.good}</p></div>
        <div class="tp-cell tp-trap"><h4>关系里的坑</h4><p>{t.trap}</p></div>
        <div class="tp-cell"><h4>与谁最搭</h4><p>{t.match}</p></div>
        <div class="tp-cell tp-use"><h4>该用哪些模型</h4><p>{t.use}</p></div>
      </div>
    </div>
  ))}

  <!-- ══ ② 做题 ══ -->
  <h2 class="sub-h">做 20 题：看你的四条分数</h2>
  <div class="intro">
    <b>怎么答：</b>按你<b>平时</b>的样子，不是按你希望的样子。每题 1–5 分（很不同意 → 很同意）。
    四型不是互斥的——你可能四题都高，那说明你本来就混合得厉害，这比"选出一个型"信息量大。
  </div>
  <div class="qbar">
    <div class="qbar-track"><div class="qbar-fill" id="f4-fill"></div></div>
    <span class="qbar-txt" id="f4-txt">已答 0 / 20</span>
  </div>
  <div class="items" id="f4-items">
    {f4.map((it, i) => (
      <div class="item" data-i={i}>
        <p class="item-t"><span class="item-no">{i + 1}</span>{it.t}</p>
        <div class="lk" data-i={i}>
          {['很不同意', '不同意', '一般', '同意', '很同意'].map((L, v) => (
            <button class="lk-b" type="button" data-v={v + 1}>{L}</button>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="acts">
    <button class="btn ghost" id="f4-reset" type="button">重做</button>
    <button class="btn" id="f4-go" type="button">看结果 →</button>
  </div>
  <div class="res" id="f4-res" hidden></div>

  <!-- ══ ③ 为什么只有 4 类 ══ -->
  <h2 class="sub-h">为什么最后是这 4 类</h2>
  <p class="plain">
    先说清楚一件可能反直觉的事：<b>选 4 类不是因为它最准</b>。三套常见框架里，这 4 类的精度是<b>最低的</b>。
    选它是因为它是唯一直接给出「<b>约会时怎么识别、和谁最搭、该用哪个模型</b>」的一套——
    另外两套给的是剖面和词汇，给不出动作。
  </p>
  <div class="vt">
    <div class="vt-row vt-head">
      <div class="vt-c0"></div>
      <div class="vt-c vt-amber">🧬 四型 · FTI<br><span>本站主类型（就是这页）</span></div>
      <div class="vt-c vt-red">🧭 16 型 · 荣格<br><span>MBTI 的公开版理论</span></div>
      <div class="vt-c vt-green">📐 大五 · OCEAN<br><span>学界金标准</span></div>
    </div>
    <div class="vt-row">
      <div class="vt-c0">分几类</div>
      <div class="vt-c"><b>4 个类型</b></div>
      <div class="vt-c">16 个类型</div>
      <div class="vt-c">不分类型，5 条连续轴</div>
    </div>
    <div class="vt-row">
      <div class="vt-c0">理论来源</div>
      <div class="vt-c">4 个神经递质系统 + fMRI 影像证据</div>
      <div class="vt-c">荣格 1921，自上而下编题</div>
      <div class="vt-c">词汇学因子分析，自下而上</div>
    </div>
    <div class="vt-row">
      <div class="vt-c0">重测信度</div>
      <div class="vt-c"><b class="amber">未公布</b></div>
      <div class="vt-c"><b class="red">0.56 – 0.72</b> 偏低</div>
      <div class="vt-c"><b class="green">&gt; 0.80</b> 稳定</div>
    </div>
    <div class="vt-row">
      <div class="vt-c0">"类型"站得住吗</div>
      <div class="vt-c"><b class="amber">没有证据</b>：4 个类别的聚类从未被同行评审证实</div>
      <div class="vt-c"><b class="red">没有证据</b>：维度间交互几乎不显著，16 格立不住</div>
      <div class="vt-c"><b class="green">不适用</b>：它本来就不把人塞进格子</div>
    </div>
    <div class="vt-row">
      <div class="vt-c0">独立验证</div>
      <div class="vt-c">有：与 NEO 大五收敛相关（n=215）、7 国 7 万+ 样本、影像学锚点；但分类学未经验证</div>
      <div class="vt-c">维度可被大五覆盖（缺神经质整个维度）；预测职业满意度≈随机</div>
      <div class="vt-c">数十国复现，学术与临床通用，重测 &gt; 0.8</div>
    </div>
    <div class="vt-row">
      <div class="vt-c0">能给出动作吗</div>
      <div class="vt-c"><b class="amber">能</b>：约会时如何识别、与谁最搭、该用哪个模型</div>
      <div class="vt-c">一般：给了描述差异的词汇，但动作靠你自己想</div>
      <div class="vt-c">弱：剖面很准，但"尽责性 78%"之后该做什么，它不说</div>
    </div>
  </div>
  <p class="vt-note">⚠️ <b>所以这么用：</b>把四型当<b>约会场景的操作手册</b>——它能告诉你行动，但别拿它给人下判断（精度最低）。
    如果你真正想要"准"，要用的是大五；本站没把大五做成量表，是因为它给不出下一步动作，而这里是恋爱手记不是心理测评。
    另外：MBTI® 是 The Myers-Briggs Company 的注册商标、官方量表无免费版，网上一切免费"MBTI 测试"都是基于荣格 1921 年公开理论的仿制品。</p>

  <h2 class="sub-h">如果你熟悉大五 / MBTI：换算参考</h2>
  <p class="plain">下面是<b>模态对应，不是等价</b>——一个人完全可能四型是探索者、大五却是低开放性。</p>
  <div class="map">
    {mapping.map((m) => (
      <div class="map-row">
        <div class="map-cell map-f4">{m.f4}</div>
        <div class="map-arrow">≈</div>
        <div class="map-cell">{m.b5}</div>
        <div class="map-arrow">≈</div>
        <div class="map-cell">{m.t16}</div>
        <div class="map-note">{m.note}</div>
      </div>
    ))}
  </div>

  <section class="engage">
    <p class="engage-tip">做完之后，去闯关页看看"你这型该先打哪一关" 👇</p>
    <p class="engage-links">
      <a href={`${base}love-quest/`} class="lnk">🎮 爱情八关：先判断你在哪一幕 →</a>
      <a href={`${base}love-type/`} class="lnk">🧬 四型 · 约会情境版 20 题 →</a>
      <a href={`${base}love-math/`} class="lnk">🧩 爱情数学：十二个模型 →</a>
    </p>
    <div class="reward">
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/alipay.png`} alt="支付宝收款码" loading="lazy" /></div>
        <p>支付宝</p>
      </div>
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/wechat.png`} alt="微信收款码" loading="lazy" /></div>
        <p>微信</p>
      </div>
    </div>
  </section>

  <p class="foot-note">⚠️ 本页是通俗框架的自测，不是心理测评量表，不构成心理咨询或专业建议。
    四型（FTI）的理论锚点有神经影像与大规模行为样本支持，但<b>作为一套人格分类学未经同行评审验证</b>——
    没有研究能确认「4 个类型是人群中统计上可分的聚类」。同一人在不同情境会切换类型，别拿标签框住自己或对方。</p>
</main>

<script type="application/json" id="pp-data" set:html={JSON.stringify({ base, types, poles: f4.map((x) => x.p) })}></script>

<script is:inline>
  (function () {
    var CFG = JSON.parse(document.getElementById('pp-data').textContent);
    var LS_KEY = 'love-personality-v2';
    var N = 20;
    var ans = {};
    var meta = {};
    CFG.types.forEach(function (t) { meta[t.id] = t; });

    function save() { try { localStorage.setItem(LS_KEY, JSON.stringify(ans)); } catch (e) {} }
    function load() {
      try { var s = JSON.parse(localStorage.getItem(LS_KEY) || 'null'); if (s && typeof s === 'object') ans = s; } catch (e) {}
    }
    load();

    // ── 速查表展开 ──
    var cards = document.querySelectorAll('#tcards .tcard');
    var panes = document.querySelectorAll('.tpane');
    cards.forEach(function (c) {
      c.addEventListener('click', function () {
        var id = c.getAttribute('data-type');
        var wasOpen = !document.querySelector('.tpane[data-type="' + id + '"]').hidden;
        panes.forEach(function (p) { p.hidden = true; });
        cards.forEach(function (x) { x.classList.remove('on'); x.querySelector('.tc-go').textContent = '展开 ↓'; });
        if (wasOpen) return;
        document.querySelector('.tpane[data-type="' + id + '"]').hidden = false;
        c.classList.add('on');
        c.querySelector('.tc-go').textContent = '收起 ↑';
      });
    });

    // ── 答题 ──
    function paint() {
      var done = Object.keys(ans).length;
      document.querySelectorAll('.lk').forEach(function (g) {
        var i = g.getAttribute('data-i');
        g.querySelectorAll('.lk-b').forEach(function (b) {
          b.classList.toggle('on', ans[i] === parseInt(b.getAttribute('data-v'), 10));
        });
      });
      document.getElementById('f4-fill').style.width = Math.round((done / N) * 100) + '%';
      document.getElementById('f4-txt').textContent = done === N ? '已完成 · ' + N + ' / ' + N : '已答 ' + done + ' / ' + N;
      var go = document.getElementById('f4-go');
      go.disabled = done < N;
      go.textContent = done < N ? '还差 ' + (N - done) + ' 题' : '看结果 →';
    }
    document.querySelectorAll('.lk-b').forEach(function (b) {
      b.addEventListener('click', function () {
        var g = b.parentNode;
        ans[g.getAttribute('data-i')] = parseInt(b.getAttribute('data-v'), 10);
        save();
        paint();
      });
    });
    paint();

    document.getElementById('f4-reset').addEventListener('click', function () {
      ans = {}; save(); paint();
      var r = document.getElementById('f4-res'); r.hidden = true; r.innerHTML = '';
      window.scrollTo({ top: document.getElementById('f4-items').offsetTop - 80, behavior: 'smooth' });
    });

    // ── 计分 ──
    function score() {
      var sum = { E: 0, B: 0, D: 0, N: 0 };
      Object.keys(ans).forEach(function (i) {
        var p = CFG.poles[parseInt(i, 10)];
        if (p) sum[p] += ans[i];
      });
      var tot = 0;
      Object.keys(sum).forEach(function (k) { tot += sum[k]; });
      tot = tot || 1;
      return Object.keys(sum).map(function (k) {
        return {
          id: k, sum: sum[k],
          share: Math.round((sum[k] / tot) * 100),   // 占比：四型之间的相对强弱
          abs: Math.round((sum[k] / 25) * 100),      // 绝对强度：这型本身有多像你（满分 25）
        };
      }).sort(function (x, y) { return y.share - x.share; });
    }

    function bar(m, pct, right) {
      return '<div class="bar-row"><span class="bar-name">' + m.emoji + ' ' + m.name + '</span>' +
        '<span class="bar-track"><span class="bar-fill" style="width:' + pct + '%;background:' + m.color + '"></span></span>' +
        '<span class="bar-num">' + pct + '%<small>' + (right || '') + '</small></span></div>';
    }

    function showResult() {
      var r = score();
      var top = r[0], second = r[1];
      var close = top.share - second.share <= 5;
      var list = close ? [top, second] : [top];
      var T = meta[top.id];

      var html = '<h3 class="res-h">你的四型分数</h3>';
      html += '<div class="hero" style="--c:' + T.color + '">' +
        '<div class="hero-emoji">' + T.emoji + '</div>' +
        '<div class="hero-txt">' +
        '<div class="hero-kicker">' + (close ? '你的主导型（双主型）' : '你的主导型') + '</div>' +
        '<div class="hero-name">' + T.name + ' <small>' + T.en + '</small></div>' +
        '<div class="hero-chem">化学底色：' + T.chem + (close ? '　·　副型：' + meta[second.id].emoji + ' ' + meta[second.id].name : '') + '</div>' +
        '</div></div>';
      if (close) {
        var near = r.filter(function (x) { return top.share - x.share <= 5; });
        html += '<p class="rh-tie">' + near.map(function (x) { return meta[x.id].name + ' ' + x.share + '%'; }).join(' / ') +
          ' —— 这几型咬得非常近。你不是"选不出来"，而是真的在它们之间来回切换。下面把最接近的两张卡都列出来，' +
          (near.length > 2 ? '其余 ' + (near.length - 2) + ' 型看上面的占比条即可。' : '两张都看。') + '</p>';
      }

      html += '<div class="bars"><div class="bars-h">四型占比（相对强弱）</div>';
      r.forEach(function (x) { html += bar(meta[x.id], x.share); });
      html += '</div><div class="bars"><div class="bars-h">每型的绝对强度（这型本身有多像你，满分 100）</div>';
      r.slice().sort(function (a, b) { return b.abs - a.abs; }).forEach(function (x) { html += bar(meta[x.id], x.abs, '·' + x.sum + '/25'); });
      html += '</div>';

      var allLow = r.every(function (x) { return x.abs <= 55; });
      var allHigh = r.filter(function (x) { return x.abs >= 70; }).length >= 3;
      html += '<div class="note-card">' + (allLow
        ? '💡 <b>你四型都不算高。</b>这通常意味着题目里的描述跟你都不太贴，或者你在不同场合差别很大。这种情况下，占比的参考价值有限——别硬选一个型。'
        : allHigh
          ? '💡 <b>你有三型以上都很高。</b>这说明你混合得很厉害，主导型只比其余的强一点。真正有用的不是"你是哪一型"，而是看下面排序：你<b>最低</b>的那型，往往才是你真正缺的东西。'
          : '💡 <b>怎么看这两组条：</b>「占比」看四型之间谁更强；「绝对强度」看这型本身有多像你。两型占比接近时，看绝对强度更有用——占比高可能只是因为别的型更低。') + '</div>';

      html += '<div class="res-cards">';
      list.forEach(function (x) {
        var m = meta[x.id];
        html += '<div class="rc" style="border-left-color:' + m.color + '">' +
          '<div class="rc-h"><b style="color:' + m.color + '">' + m.emoji + ' ' + m.name + ' <small>' + m.en + '</small></b>' +
          '<span class="rc-band" style="background:' + m.color + '22;color:' + m.color + '">占比 ' + x.share + '% · 强度 ' + x.abs + '</span></div>' +
          '<div class="tp-grid">' +
          '<div class="tp-cell tp-good"><h4>优势</h4><p>' + m.good + '</p></div>' +
          '<div class="tp-cell tp-trap"><h4>关系里的坑</h4><p>' + m.trap + '</p></div>' +
          '<div class="tp-cell"><h4>与谁最搭</h4><p>' + m.match + '</p></div>' +
          '<div class="tp-cell tp-use"><h4>该用哪些模型</h4><p>' + m.use + '</p></div>' +
          '</div></div>';
      });
      html += '</div>';

      html += '<div class="note-card">🎯 <b>下一步：</b>' +
        '<a href="' + CFG.base + 'love-quest/">去「爱情八关」先判断你在哪一幕</a>——' +
        '你这型的必修关会不一样（探索者通常缺"定下来"，建设者通常缺"松条件"，主导者通常缺"别追塔尖"，协商者通常缺"主动提")。</div>';

      var el = document.getElementById('f4-res');
      el.innerHTML = html;
      el.hidden = false;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    document.getElementById('f4-go').addEventListener('click', showResult);
  })();
</script>

<style is:global>
