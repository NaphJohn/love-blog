      { k: '滑板（3% 的人写）', v: '3.507', note: '信息量最高' },
      { k: '吉他（6%）', v: '2.813', note: '' },
      { k: '爬山（9%）', v: '2.408', note: '' },
      { k: '幽默（62%）', v: '0.478', note: '最接近「人人都写」' },
      { k: '三个具体词 vs 三个虚词', v: '4.3 ×', note: '7.747 vs 1.810' },
