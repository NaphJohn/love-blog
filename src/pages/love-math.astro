  .m-item:hover { border-color: var(--accent); }
  .m-item.on { border-color: var(--accent); background: rgba(224,69,123,0.08); font-weight: 600; }
  .m-no { color: var(--accent); font-weight: 800; font-variant-numeric: tabular-nums; font-size: 12.5px; flex: none; }
  .m-emoji { flex: none; }
  .m-name { flex: 1; line-height: 1.35; }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .t-strict { background: #16a34a; }
  .t-assumption { background: #d97706; }
  .t-param { background: #dc2626; }
  .t-meta { background: #6366f1; }
  .tier-legend { margin-top: 18px; color: var(--muted); font-size: 12.5px; display: flex; flex-wrap: wrap; gap: 14px; }
  .tier-legend .lg { display: inline-flex; align-items: center; gap: 5px; }

  .m-card { border: 1px solid var(--border); border-radius: 12px; padding: 20px; background: var(--bg); }
  .m-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .m-badge { background: var(--accent); color: #fff; font-size: 12.5px; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
  .m-ch { color: var(--muted); font-size: 12.5px; }
