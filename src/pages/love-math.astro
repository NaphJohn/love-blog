  .meta { color: var(--muted); font-size: 13px; margin: 0 0 20px; line-height: 1.7; }
  code { background: var(--code-bg); padding: 1.5px 6px; border-radius: 4px; font-size: .88em; }

  .lede { background: var(--code-bg); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 0 10px 10px 0; padding: 16px 20px; margin: 0 0 22px; }
  .lede p { margin: 0 0 8px; }
  .lede.small { padding: 12px 16px; }
  .lede ol { margin: 6px 0 0; padding-left: 20px; }
  .lede li { margin: 6px 0; line-height: 1.7; }
  .lede b { color: var(--accent); }

  /* tab 栏 */
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  .tab { padding: 8px 16px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg); color: var(--fg); font-size: 14px; cursor: pointer; transition: .18s; text-decoration: none; }
  .tab:hover { border-color: var(--accent); color: var(--accent); }
  .tab.on { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .tab.quiz-cta { margin-left: auto; border-style: dashed; color: var(--accent); }

  .panel { display: none; }
  .panel.on { display: block; animation: fade .28s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .hint { color: var(--muted); font-size: 14px; margin: 0 0 16px; }
  .plain { color: var(--fg); font-size: 15px; line-height: 1.8; margin: 12px 0; }
  .sub-h { font-size: 19px; margin: 34px 0 10px; border-left: 4px solid var(--accent); padding-left: 10px; }

  /* 模型区 */
  .m-layout { display: grid; grid-template-columns: 258px 1fr; gap: 18px; align-items: start; }
