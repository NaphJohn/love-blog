  { no: 7, name: '何时安定', models: [1, 3], note: '什么时候定下来（观察期比例），以及定下来之后靠什么撑住（相似 vs 互补）。' },
  { no: 8, name: '如何办一场婚礼', models: [12], note: '座位是图划分、请柬是二项分布——两道纯组合数学题。' },
  { no: 9, name: '如何一直幸福', models: [3, 4], note: '冷战是协调问题不是利益冲突；相似度是及格线、互补度是加分项。' },
];

