  .m-tagline { color: var(--accent); font-size: 14.5px; margin: 0 0 14px; font-weight: 600; }
  .m-formula { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; margin: 0 0 14px; }
  .f-label { display: block; color: var(--muted); font-size: 11.5px; margin-bottom: 3px; letter-spacing: 1px; }
  .m-formula code { background: none; padding: 0; font-size: 13px; }
  .m-nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(158px, 1fr)); gap: 9px; margin: 0 0 16px; }
  .kv { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 9px 11px; }
  .kv span { display: block; color: var(--muted); font-size: 11.5px; line-height: 1.4; }
