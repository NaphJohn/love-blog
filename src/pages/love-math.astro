    // ── 模型点选 ──
    var items = document.querySelectorAll('.m-item');
    var cards = document.querySelectorAll('.m-card');
    function pick(key) {
      items.forEach(function (it) {
        var on = it.getAttribute('data-key') === key;
        it.classList.toggle('on', on);
        it.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      cards.forEach(function (c) { c.hidden = c.getAttribute('data-key') !== key; });
      try { history.replaceState(null, '', '#' + key); } catch (e) {}
    }
    var ensured = false;
    function ensureModel() {
      if (ensured) return;
      ensured = true;
      var h = (location.hash || '').replace('#', '');
      var ok = false;
      cards.forEach(function (c) { if (c.getAttribute('data-key') === h) ok = true; });
      pick(ok ? h : 'stop');
    }
    items.forEach(function (it) {
      it.addEventListener('click', function () { pick(it.getAttribute('data-key')); });
    });
    ensureModel();

    // ── 章节里的「模型 N」小药丸 → 跳到对应模型 ──
    document.querySelectorAll('.pill[data-model]').forEach(function (b) {
      b.addEventListener('click', function () {
        var n = parseInt(b.getAttribute('data-model'), 10);
        var target = null;
        cards.forEach(function (c) {
          var t = c.querySelector('.m-badge');
          if (t && t.textContent.indexOf('模型 ' + n) >= 0) target = c.getAttribute('data-key');
        });
        var tab = document.querySelector('.tab[data-tab="models"]');
        if (tab) tab.click();
        if (target) pick(target);
      });
    });
  })();
</script>

