    formula: 'P(k, n) = (k/n) · Σ(i = k+1 → n) 1/(i − 1)',
    numbers: [
      { k: 'n = 100 最优 k', v: '37', note: 'k/n = 0.370' },
      { k: '精确成功率', v: '0.3710', note: '峰值' },
      { k: '蒙特卡洛 20 万次', v: '0.3708', note: '与精确值吻合' },
      { k: '理论极限 1/e', v: '0.367879', note: 'n → ∞' },
