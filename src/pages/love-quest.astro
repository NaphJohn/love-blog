---
import SiteHeader from '../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;
---

<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      if (t !== 'light' && t !== 'dark') {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
</script>

<SiteHeader lang="zh" series="心动解码" />

<main class="qz">
  <p class="kicker">✦ 爱情数学 · 闯关版 · 八关四幕</p>
  <h1>爱情八关：先判断你在哪一幕，再决定该做哪些判断</h1>
  <p class="meta">每一关都是一个具体场景 + 四个判断，选完立刻告诉你<b>数学上哪个更优</b>、为什么，以及它对应十二个模型里的哪一个。数字与 <a href={`${base}love-math/`}>爱情数学</a> 同源，全部现算。</p>

  <!-- ══ 阶段定位 ══ -->
  <section class="qz-box" id="v-pos">
    <div class="qz-box-head">
      <span class="qz-kick">第 0 步 · 定位</span>
      <h2>你现在在第几幕？</h2>
      <p class="qz-sub">两道题。答完告诉你当前该打哪几关（必修），其余是支线，可以打也可以跳过。</p>
    </div>
    <div class="pos-q" id="pos-q1"></div>
    <div class="pos-q" id="pos-q2" hidden></div>
    <div class="pos-out" id="pos-out" hidden></div>
    <div class="pos-skip"><button class="qz-btn ghost" id="pos-skip" type="button">跳过定位，直接从第 1 关开始 →</button></div>
  </section>

  <!-- ══ 关卡地图 ══ -->
  <section class="qz-box" id="v-map" hidden>
    <div class="map-head">
      <div>
        <span class="qz-kick">关卡地图</span>
        <h2 id="map-h">八关 · 四幕</h2>
      </div>
      <div class="map-score">
        <span id="map-score">0 / 16</span>
        <button class="qz-btn ghost" id="map-finish" type="button">看结算 →</button>
        <button class="qz-btn ghost" id="map-repos" type="button">重新定位</button>
      </div>
    </div>
    <p class="qz-hint" id="map-tip"></p>
    <div id="map-acts"></div>
  </section>

  <!-- ══ 单关 ══ -->
  <section class="qz-box" id="v-level" hidden>
    <button class="qz-back" id="lv-back" type="button">← 回到地图</button>
    <div id="lv-body"></div>
    <div class="lv-nav" id="lv-nav" hidden>
      <button class="qz-btn" id="lv-next" type="button">下一关 →</button>
      <button class="qz-btn ghost" id="lv-retry" type="button">重做本关</button>
    </div>
  </section>

  <!-- ══ 结算 ══ -->
  <section class="qz-box" id="v-result" hidden>
    <div id="res-body"></div>
    <div class="lv-nav">
      <button class="qz-btn" id="res-again" type="button">全部重打</button>
      <button class="qz-btn ghost" id="res-map" type="button">回到地图</button>
    </div>
  </section>

  <section class="engage">
    <p class="engage-tip">觉得有用？欢迎请作者喝杯咖啡 ☕️</p>
    <div class="reward">
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/alipay.png`} alt="支付宝收款码" loading="lazy" /></div>
        <p>支付宝</p>
      </div>
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/wechat.png`} alt="微信收款码" loading="lazy" /></div>
        <p>微信</p>
      </div>
    </div>
  </section>

  <p class="engage-links">
    <a href={`${base}love-math/`} class="lnk">🧩 爱情数学：九章 × 十二个模型 →</a>
    <a href={`${base}love-math/#wizard`} class="lnk">🧭 决策向导：5 道题给你一份评估 →</a>
    <a href={`${base}love-personality/`} class="lnk">🧬 四型人格测试 →</a>
    <a href={`${base}love-count/`} class="lnk">🔢 我的 N 是多少：什么才算「见过一个人」 →</a>
  </p>

  <p class="foot-note">⚠️ 本文为读书笔记与自建模型的复现，不构成心理学、心理咨询或专业建议。第 6 关（送礼）是把「信息量」模型做的类比迁移，不是原书结论、也没有实证支持，已在关内标注。</p>
</main>

<script is:inline>
  (function () {
    var BASE = document.querySelector('a.lnk') ? document.querySelector('a.lnk').getAttribute('href').replace(/love-math\/.*$/, '') : '/love-blog/';
    var LS = 'love-quest-v1';

    /* ══ 关卡数据 ══ */
    var ACTS = [
      { id: 1, name: '找', sub: '还没定下来', desc: '这一幕要解决的问题是「池子」和「时机」——不是努力程度。' },
