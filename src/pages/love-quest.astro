      {
        id: 7, act: 3, emoji: '🧊', key: 'chicken', model: '模型 4 Chicken 博弈',
        title: '怎么道歉：改机制，不是改「谁更愿意」',
        scene: '冷战第二天了。你觉得这次自己大概有六成的问题。',
        q: '你的判断是？',
        opts: [
          { t: '先各自冷静 20 分钟，然后提一句：这次我先开口，下次轮到你', d: '生理 + 机制', s: 2, tag: 'best',
            why: '对，而且顺序也对：先处理生理（心跳不回落人是<b>没有能力</b>讲道理的），再把「谁让步」这件事<b>从博弈里拿出来</b>。规则必须在不吵架的时候定，这次只是执行它。' },
          { t: '我现在就道歉，并保证以后都由我先', d: '我错得多，我应该', s: 1, tag: 'ok',
            why: '把 p 从 0.50 拉到 0.80，单期收益也才 +0.842，期数只从 1.33 降到 1.04——因为随机化总会撞上「两个都不道歉」。而且它把「谁让步」变成默认分配，是一笔隐性负债。' },
          { t: '等对方开口，谁先开口谁就输了', d: '这次我没错那么多', s: 0, tag: 'bad',
            why: '两个纯策略纳什均衡都落在「一个道歉、一个不道歉」上——<b>均衡定了，但没定是谁</b>。这句话本身就是冷战的定义。' },
          { t: '先各自冷静 20 分钟，之后再说', d: '先别在气头上谈', s: 1, tag: 'ok',
            why: '必要的生理前置（Gottman 的 20 分钟实验直接支持），但它没解决「谁先开口」——冷静完，僵局还在那儿。' },
        ],
        math: '期望冷战期数 = 1 / (1 − (1−p₁)(1−p₂))。混合纳什 p = 0.50 → <b>1.33 期</b>；调到 0.80 也只到 1.04。<b>相关均衡（轮流）= 0 期</b>，收益 +1.005/期。',
        nums: [
          { k: '混合纳什 p = 0.50', v: '1.33 期', n: '收益 ≈ −0.001' },
          { k: '把 p 拉到 0.80', v: '1.04 期', n: '收益 +0.842，天花板' },
          { k: '轮流先退一步（相关均衡）', v: '0 期', n: '冷战清零' },
          { k: '机制收益', v: '+1.005 / 期', n: '严格结论，与参数无关' },
        ],
        tip: '三个可以直接抄的外部规则：「这周轮到谁先开口」「谁先冷静下来谁先说话」「按单双日」。规则本身不重要，<b>外部 + 事先</b>才重要。',
      },
      {
        id: 8, act: 4, emoji: '🌱', key: 'hazard', model: '模型 3 相似 / 互补',
        title: '怎么让关系长久：先补及格线',
        scene: '你们很相爱，但你心里有 <b>3 条「希望对方改」</b>。',
        q: '你的判断是？',
        opts: [
          { t: '逐条判断：能接受就把它从问题清单里划掉，不能接受就当场筛掉', d: '不允许它悬在中间', s: 2, tag: 'best',
            why: '对。凡是「我希望他改」的 → 归<b>相似</b>类、当场决定能不能接受；凡是「我欣赏但不必参与」的 → 才归<b>互补</b>类。把前者当成后者，是这套模型里最常见的误用。' },
          { t: '相爱就能磨合，给时间', d: '感情基础在', s: 0, tag: 'bad',
            why: 'Gottman：<b>69% 的关系问题是永久性的、解决不掉的</b>。「以后会好的」在统计上是低概率事件。' },
          { t: '多培养共同爱好，提升互补度', d: '一起做点新的事', s: 1, tag: 'ok',
            why: '互补度拉满只延 <b>1.72 倍</b>，相似度拉满延 <b>7.2 倍</b>。方向对，但优先级排错了——先补及格线，再谈加分项。' },
          { t: '多沟通，把话说开', d: '沟通能解决一切', s: 0, tag: 'bad',
            why: '不可证伪：没有任何观察能反驳「要多沟通」。它没有给出机制，所以它不是一条判断，只是一句安慰。' },
        ],
        math: 'λ(s,c) = λ₀·exp(−a·s − b·c)，E[T] = 1/λ。示意参数 a = 2.2、b = 0.6 下：<b>相似度是及格线，互补度是加分项</b>。',
        nums: [
          { k: '相似度 s：0 → 0.9', v: '2.0 → 14.5 年', n: '7.2 倍' },
          { k: '互补度 c：0 → 0.9（s = 0.6）', v: '7.5 → 12.8 年', n: '只 1.72 倍' },
          { k: 's = c = 0.9', v: '24.9 年', n: '示意参数下的上界' },
          { k: '把权重倒过来（a:b = 0.6:2.2）', v: '结论翻转', n: '这是参数性的，不是定理' },
        ],
        warn: '🚩 这个排序<b>不是定理</b>，是 a = 2.2 > b = 0.6 这个假设的直接产物。把权重倒过来，结论立刻反转。正确的说法是：「如果你认为相似的权重是互补的 3.67 倍，那么……」。',
      },
    ];

    /* ══ 定位 ══ */
    var POS = [
      { id: 'st', q: '你现在的状态是？', opts: [
        { t: '单身，正在找', v: 'single' },
        { t: '有暧昧 / 刚认识的人', v: 'talking' },
        { t: '稳定交往中', v: 'together' },
        { t: '长期关系 / 已婚', v: 'long' },
        { t: '刚结束一段', v: 'ex' },
      ]},
      { id: 'gl', q: '你最想解决的是？', opts: [
        { t: '找到对的人', v: 'find' },
        { t: '让他 / 她回应我', v: 'respond' },
        { t: '别再冷战了', v: 'cold' },
        { t: '这段要不要继续', v: 'continue' },
        { t: '让关系更好', v: 'better' },
      ]},
    ];
    var ACT_OF = { single: 1, ex: 1, talking: 2, together: 3, long: 4 };
    var GOAL_LV = { find: [1, 2], respond: [3, 4, 5], cold: [7], continue: [8], better: [6, 8] };
    var ACT_FIRST = { 1: 1, 2: 3, 3: 6, 4: 7 };
    var GOAL_NAME = { find: '找到对的人', respond: '让他 / 她回应我', cold: '别再冷战了', continue: '这段要不要继续', better: '让关系更好' };

    var st = { pos: {}, act: null, goal: null, need: [], ans: {}, unlocked: 1 };
    try {
      var raw = localStorage.getItem(LS);
      if (raw) { var s0 = JSON.parse(raw); if (s0 && s0.ans) { st = s0; st.need = st.need || []; } }
    } catch (e) {}

    function save() { try { localStorage.setItem(LS, JSON.stringify(st)); } catch (e) {} }
    function score() { var n = 0; Object.keys(st.ans).forEach(function (k) { n += st.ans[k].s; }); return n; }
    function done() { return Object.keys(st.ans).length; }

    var V = { pos: document.getElementById('v-pos'), map: document.getElementById('v-map'), level: document.getElementById('v-level'), result: document.getElementById('v-result') };
    function view(name) {
      Object.keys(V).forEach(function (k) { V[k].hidden = k !== name; });
      if (window.scrollTo) window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* ── 定位渲染 ── */
    function renderPos() {
      renderPosQ(0);
      document.getElementById('pos-q2').hidden = !st.pos.st;
      if (st.pos.st) renderPosQ(1);
      if (st.pos.st && st.pos.gl) renderPosOut();
      else document.getElementById('pos-out').hidden = true;
    }
    function renderPosQ(i) {
      var p = POS[i], box = document.getElementById('pos-q' + (i + 1));
      var h = '<h3 class="pos-q-t">' + p.q + '</h3><div class="wz-opts">';
      p.opts.forEach(function (o, j) {
        var on = st.pos[p.id] === o.v;
        h += '<button class="wz-opt' + (on ? ' on' : '') + '" type="button" data-i="' + j + '"><span class="wz-opt-t">' + o.t + '</span></button>';
      });
      h += '</div>';
      box.innerHTML = h;
      box.querySelectorAll('.wz-opt').forEach(function (b) {
        b.addEventListener('click', function () {
          st.pos[p.id] = p.opts[parseInt(b.getAttribute('data-i'), 10)].v;
          save(); renderPos();
        });
      });
    }
    function renderPosOut() {
      st.act = ACT_OF[st.pos.st] || 1;
      st.goal = st.pos.gl;
      var main = LEVELS.filter(function (l) { return l.act === st.act; }).map(function (l) { return l.id; });
      st.need = main.concat(GOAL_LV[st.goal] || []).filter(function (v, i, a) { return a.indexOf(v) === i; }).sort(function (a, b) { return a - b; });
      st.unlocked = Math.max(st.unlocked, ACT_FIRST[st.act]);
      save();
      var a = ACTS[st.act - 1];
      var h = '<div class="pos-card">' +
        '<span class="qz-kick">你现在的幕</span>' +
        '<h3>第 ' + st.act + ' 幕 · <b>' + a.name + '</b>　<span class="pos-sub">' + a.sub + '</span></h3>' +
        '<p class="pos-desc">' + a.desc + '</p>' +
        '<p class="pos-need">必修关：<b>' + st.need.map(function (n) { return '第 ' + n + ' 关'; }).join(' · ') + '</b>　（其余是支线，可以打也可以跳）</p>' +
        '<button class="qz-btn" id="pos-go" type="button">进入关卡地图 →</button>' +
        '</div>';
      var box = document.getElementById('pos-out');
      box.innerHTML = h; box.hidden = false;
      document.getElementById('pos-go').addEventListener('click', function () { renderMap(); view('map'); });
      if (box.scrollIntoView) box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    /* ── 地图 ── */
    function renderMap() {
      var h = '';
      ACTS.forEach(function (a) {
        var ls = LEVELS.filter(function (l) { return l.act === a.id; });
        var isCur = st.act === a.id;
        h += '<div class="act' + (isCur ? ' cur' : '') + '">' +
          '<div class="act-h"><span class="act-no">第 ' + a.id + ' 幕</span><span class="act-nm">' + a.name + '</span>' +
          '<span class="act-sub">' + a.sub + '</span>' + (isCur ? '<span class="act-badge">你在这里</span>' : '') + '</div><div class="act-ls">';
        ls.forEach(function (l) {
          var got = st.ans[l.id], locked = l.id > st.unlocked;
          var stars = got ? (got.s === 2 ? '★★' : got.s === 1 ? '★' : '✗') : '';
          var need = st.need.indexOf(l.id) >= 0;
          h += '<button class="lv-card' + (locked ? ' locked' : '') + (got ? ' done' : '') + (need && !got ? ' need' : '') + '" type="button" data-lv="' + l.id + '"' + (locked ? ' disabled' : '') + '>' +
            '<span class="lv-no">' + (locked ? '🔒' : l.id) + '</span>' +
            '<span class="lv-em">' + l.emoji + '</span>' +
            '<span class="lv-t">' + l.title + '</span>' +
            '<span class="lv-m">' + l.model + '</span>' +
            '<span class="lv-st">' + stars + '</span>' +
            (need ? '<span class="lv-need">必修</span>' : '') +
            '</button>';
        });
        h += '</div></div>';
      });
      document.getElementById('map-acts').innerHTML = h;
      document.getElementById('map-score').textContent = score() + ' / 16　（已通 ' + done() + '/8 关）';
      document.getElementById('map-h').textContent = st.act ? '八关 · 四幕　你在第 ' + st.act + ' 幕' : '八关 · 四幕';
      document.getElementById('map-tip').textContent = st.act
        ? '高亮的是你这一幕的必修关。通关一关即解锁下一关；也可以随时看结算。'
        : '通关一关即解锁下一关。想让系统推荐必修关，可以回第一步做定位。';
      document.getElementById('map-acts').querySelectorAll('[data-lv]').forEach(function (b) {
        b.addEventListener('click', function () { openLevel(parseInt(b.getAttribute('data-lv'), 10)); });
      });
    }

    /* ── 单关 ── */
    var curLv = null;
    function openLevel(id) {
      curLv = LEVELS[id - 1];
      var l = curLv, got = st.ans[l.id];
      var a = ACTS[l.act - 1];
      var h = '<div class="lv-head">' +
        '<span class="qz-kick">第 ' + a.id + ' 幕 · ' + a.name + '　|　第 ' + l.id + ' 关 / 8</span>' +
        '<h2>' + l.emoji + ' ' + l.title + '</h2>' +
        '<span class="lv-model">' + l.model + '</span></div>' +
        '<div class="lv-scene"><span class="sc-label">情境</span><p>' + l.scene + '</p></div>' +
        '<h3 class="lv-q">' + l.q + '</h3><div class="wz-opts" id="lv-opts">';
      l.opts.forEach(function (o, i) {
        var picked = got && got.i === i;
        h += '<button class="wz-opt' + (picked ? ' on' : '') + (got ? ' disabled' : '') + '" type="button" data-i="' + i + '"' + (got ? ' disabled' : '') + '>' +
          '<span class="wz-opt-t">' + o.t + '</span><span class="wz-opt-d">' + o.d + '</span></button>';
      });
      h += '</div><div id="lv-fb"></div>';
      document.getElementById('lv-body').innerHTML = h;
      document.getElementById('lv-nav').hidden = !got;
      view('level');
      if (!got) {
        document.getElementById('lv-opts').querySelectorAll('.wz-opt').forEach(function (b) {
          b.addEventListener('click', function () { answer(parseInt(b.getAttribute('data-i'), 10)); });
        });
      } else {
        paintFb(got.i);
      }
    }
    function answer(i) {
      var l = curLv, o = l.opts[i];
      st.ans[l.id] = { i: i, s: o.s };
      st.unlocked = Math.max(st.unlocked, l.id + 1);
      save();
      paintFb(i);
      document.getElementById('lv-nav').hidden = false;
    }
    function paintFb(i) {
      var l = curLv, o = l.opts[i];
      var tagCls = o.tag === 'best' ? 'ok' : o.tag === 'ok' ? 'warn' : 'bad';
      var tagTxt = o.tag === 'best' ? '✅ 数学上更优' : o.tag === 'ok' ? '⚠️ 方向对，效率低' : '❌ 结构性错误';
      var h = '<div class="fb t-' + tagCls + '">' +
        '<span class="fb-tag">' + tagTxt + '　' + (o.s === 2 ? '+2' : o.s === 1 ? '+1' : '+0') + '</span>' +
        '<p class="fb-why">' + o.why + '</p></div>' +
        '<div class="fb-math"><span class="sc-label">这一关的数学</span><p>' + l.math + '</p></div>' +
        '<div class="wz-kvs">' + l.nums.map(function (x) {
          return '<div class="wz-kv"><span>' + x.k + '</span><b>' + x.v + '</b>' + (x.n ? '<em>' + x.n + '</em>' : '' ) + '</div>';
        }).join('') + '</div>';
      if (l.tip) h += '<div class="note-card">💡 ' + l.tip + '</div>';
      if (l.warn) h += '<div class="note-card warn">' + l.warn + '</div>';
      h += '<div class="fb-others"><h4>四个选项的完整对照</h4><ul class="wz-list">' +
        l.opts.map(function (x, j) {
          if (j === i) return '';
          return '<li><b>' + (x.tag === 'best' ? '✅' : x.tag === 'ok' ? '⚠️' : '❌') + ' ' + x.t + '</b>　' + x.why + '</li>';
        }).join('') + '</ul></div>' +
        '<p class="fb-link"><a href="' + BASE + 'love-math/#wizard" >🧭 想让这套模型按你自己的条件算一遍 → 决策向导</a></p>';
      document.getElementById('lv-fb').innerHTML = h;
      var fb = document.getElementById('lv-fb');
      if (fb.scrollIntoView) fb.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ── 结算 ── */
    function renderResult() {
      var s = score(), n = done();
      var rank = s >= 15 ? { g: 'S', t: '你把这套模型用对了', d: '八关里你几乎没有踩坑。剩下的不是认知问题，是执行问题——回到地图，把必修关再看一遍就行。' }
        : s >= 12 ? { g: 'A', t: '判断基本在线', d: '大的方向你都选对了，错的多半是「效率」而不是「方向」。下面的错关值得回头看一眼解释。' }
        : s >= 8 ? { g: 'B', t: '方向对，但有几处是反的', d: '你错的那几关有个共同点：都在用「感觉上更对的办法」替代「结构上更优的办法」。这正是这些模型存在的意义。' }
        : s >= 4 ? { g: 'C', t: '直觉在拖后腿', d: '这八关里最常见的错误是同一个：把「更努力 / 更真诚 / 更贵」当成答案，而模型说的是「改结构 / 改机制 / 改信息量」。' }
        : { g: 'D', t: '建议从必修关重打', d: '别灰心——这些判断之所以是「关」，正是因为直觉给出的答案大多不是最优解。先打你那一幕的必修关。' };
      var h = '<div class="res-hero"><span class="qz-kick">结算</span>' +
        '<div class="res-g">' + rank.g + '</div>' +
        '<h3>' + rank.t + '</h3>' +
        '<p class="res-score">' + s + ' / 16　·　通关 ' + n + ' / 8</p>' +
        '<p class="res-desc">' + rank.d + '</p></div>';
      h += '<div class="res-list"><h4>逐关回顾</h4>';
      LEVELS.forEach(function (l) {
        var g = st.ans[l.id];
        if (!g) { h += '<div class="res-row skip"><span class="rr-no">第 ' + l.id + ' 关</span><span class="rr-t">' + l.emoji + ' ' + l.title + '</span><span class="rr-s">未通关</span></div>'; return; }
        var o = l.opts[g.i];
        h += '<div class="res-row s-' + g.s + '"><span class="rr-no">第 ' + l.id + ' 关</span>' +
          '<span class="rr-t">' + l.emoji + ' ' + l.title + '<em>你选：' + o.t + '</em></span>' +
          '<span class="rr-s">' + (g.s === 2 ? '★★' : g.s === 1 ? '★' : '✗') + '</span></div>';
      });
      h += '</div>';
      var weak = LEVELS.filter(function (l) { return st.ans[l.id] && st.ans[l.id].s < 2; });
      if (weak.length) {
        h += '<div class="note-card warn">🔁 <b>建议重看的关：</b>' + weak.map(function (l) { return '第 ' + l.id + ' 关「' + l.title.split('：')[0] + '」'; }).join(' · ') +
          '　——这几关的共同点是：直觉答案和最优答案不一致。</div>';
      }
      document.getElementById('res-body').innerHTML = h;
      view('result');
    }

    /* ── 绑定 ── */
    document.getElementById('pos-skip').addEventListener('click', function () { renderMap(); view('map'); });
    document.getElementById('lv-back').addEventListener('click', function () { renderMap(); view('map'); });
    document.getElementById('lv-next').addEventListener('click', function () {
      var n = curLv ? curLv.id + 1 : 1;
      if (n > 8) { renderResult(); return; }
      openLevel(n);
    });
    document.getElementById('lv-retry').addEventListener('click', function () {
      delete st.ans[curLv.id]; save(); openLevel(curLv.id);
    });
    document.getElementById('map-finish').addEventListener('click', renderResult);
    document.getElementById('map-repos').addEventListener('click', function () { st.pos = {}; st.act = null; st.need = []; save(); renderPos(); view('pos'); });
    document.getElementById('res-again').addEventListener('click', function () { st.ans = {}; st.unlocked = Math.max(1, st.act ? ACT_FIRST[st.act] : 1); save(); renderMap(); view('map'); });
    document.getElementById('res-map').addEventListener('click', function () { renderMap(); view('map'); });

    /* ── 深链 ?lv=N ── */
    var m = /[?&]lv=(\d+)/.exec(location.search);
    if (m) {
      var n = Math.min(8, Math.max(1, parseInt(m[1], 10)));
      st.unlocked = Math.max(st.unlocked, n); save();
      renderMap(); openLevel(n);
    } else {
      renderPos();
    }
  })();
</script>

<style is:global>
  :root { --bg-url: url('/love-blog/24solar-bg.png'); }
  body::before {
    content: ""; position: fixed; inset: 0;
    background-image: var(--bg-url); background-size: cover; background-position: center top;
    background-repeat: no-repeat; opacity: 0.13; z-index: -1; pointer-events: none;
    transition: opacity .25s ease;
  }
  :root[data-theme="dark"] body::before { opacity: 0.08; }
</style>

<style>
  .qz { max-width: 900px; margin: 0 auto; padding: 36px 20px 64px; }
  .kicker { color: var(--accent); letter-spacing: 2px; font-size: 13px; margin: 0 0 8px; }
  .qz h1 { font-size: 28px; line-height: 1.4; margin: 0 0 8px; letter-spacing: .2px; }
  .meta { color: var(--muted); font-size: 13.5px; margin: 0 0 22px; line-height: 1.75; }
  .meta b { color: var(--accent); }
  .qz a { color: var(--accent); }

  .qz-box { border: 1px solid var(--border); border-radius: 14px; padding: 22px; background: var(--bg); margin-bottom: 18px; }
  .qz-box-head { margin-bottom: 16px; }
