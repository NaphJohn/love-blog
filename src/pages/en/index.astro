---
import SiteHeader from '../../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;
const chapters = [
  { slug: 'eq1-self-awareness', title: '(1) Self-Awareness & Inner Frame — Fix Yourself Before the Relationship', desc: 'Separation of tasks, attachment styles, three daily stabilizing moves.', date: '2026-08-01', free: true },
  { slug: 'eq2-attraction', title: '(2) Attraction & First Contact — Attraction Is a Learnable Behavior, Not a Gift', desc: 'First impressions, availability, investment and sincerity.', date: '2026-08-01', free: true },
  { slug: 'eq3-gender-differences', title: '(3) Gender Communication Differences — Conflict Is Not Right vs Wrong, but Different Rules', desc: 'Turn the "listen" vs "fix" gap into collaboration.', date: '2026-08-01', free: true },
  { slug: 'eq4-nvc-crucial', title: '(4) Nonviolent Communication & Crucial Conversations — Turn Conflict into Consensus', desc: 'Observe-feel-need-request, plus crucial conversations.', date: '2026-08-01', free: false },
  { slug: 'eq5-win-favor', title: '(5) Winning Favor & Deep Connection — Make the Other "Become Better With You"', desc: 'Specific praise, healthy vulnerability, shared meaning.', date: '2026-08-01', free: false },
  { slug: 'eq6-influence-relationship', title: '(6) Influence & Long-Term Relationship Management — Let Sincerity Be Better Received', desc: 'Long-term management, influence without manipulation.', date: '2026-08-01', free: false },
];
const freeCount = chapters.filter((c) => c.free).length;
---
<SiteHeader lang="en" altLang="zh" altHref="/" />
<main class="course">
  <p class="kicker">✦ Emotional Intelligence · Intimacy · Communication</p>
  <h1>Heartbeat Decode · Love &amp; EQ Notes</h1>
  <p class="sub">A practical EQ-and-love notebook: fix yourself, be sincerely seen, understand differences, resolve conflict, connect deeply, manage long-term. First 3 episodes free; later ones unlock with a coffee for the author.</p>
  <p class="rule">First <b>{freeCount}</b> episodes are free. Later chapters unlock with a <b>coffee for the author ☕️</b> (from ¥1, no upper limit). The author is exempt.</p>

  <ol class="ch-list">
    {chapters.map((c, i) => (
      <li class={c.free ? 'free' : 'paid'}>
        <span class="no">{(i + 1).toString().padStart(2, '0')}</span>
        <a href={`${base}en/blog/${c.slug}`} class="title">{c.title}</a>
        {c.free ? <span class="tag free">Free</span> : <span class="tag paid">☕️ Coffee</span>}
        <p class="desc">{c.desc}</p>
      </li>
    ))}
  </ol>

  <section class="engage">
    <p class="engage-tip">Found these useful? Buy the author a coffee ☕️</p>
    <div class="reward">
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/alipay.png`} alt="Alipay" loading="lazy" /></div>
        <p>Alipay</p>
      </div>
      <div class="reward-col">
        <div class="reward-qr"><img src={`${base}reward/wechat.png`} alt="WeChat Pay" loading="lazy" /></div>
        <p>WeChat</p>
      </div>
    </div>
  </section>

  <p class="foot-note">⚠️ For personal growth only — not a substitute for counseling or professional advice.</p>
</main>

<style is:global>
  .course { max-width: 760px; margin: 0 auto; padding: 48px 16px 40px; }
  .kicker { color: var(--accent); letter-spacing: 2px; font-size: 13px; margin: 0 0 8px; }
  .course h1 { font-size: 32px; margin: 0 0 10px; letter-spacing: 1px; }
  .sub { color: var(--muted); font-size: 16px; line-height: 1.8; margin: 0 0 8px; }
  .rule { background: var(--code-bg); border: 1px dashed var(--border); border-radius: 8px; padding: 10px 14px; font-size: 14px; color: var(--fg); }
  .rule b { color: var(--accent); }
  .ch-list { list-style: none; padding: 0; margin: 22px 0 0; }
  .ch-list li { padding: 16px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .ch-list li.paid { border-left: 4px solid #d63031; }
  .ch-list li.free { border-left: 4px solid var(--accent); }
  .no { color: var(--accent); font-weight: 800; font-size: 15px; }
  .title { font-weight: 600; color: var(--fg); text-decoration: none; font-size: 17px; }
  .tag { font-size: 12px; padding: 1px 9px; border-radius: 999px; font-weight: 600; }
  .tag.free { background: rgba(224,69,123,0.10); color: var(--accent); }
  .tag.paid { background: rgba(214,48,49,0.12); color: #d63031; }
  .desc { width: 100%; color: var(--muted); font-size: 13px; margin: 4px 0 0; }
  .engage { margin-top: 30px; padding: 22px; border: 1px solid var(--border); border-radius: 12px; background: var(--code-bg); text-align: center; }
  .engage-tip { color: var(--fg); font-size: 15px; margin: 0 0 14px; }
  .reward { display: flex; gap: 24px; justify-content: center; align-items: flex-start; flex-wrap: wrap; }
  .reward-col { text-align: center; }
  .reward-qr { width: 120px; height: 120px; border: 1px solid var(--border); border-radius: 8px; display: flex; align-items: center; justify-content: center; background: var(--code-bg); overflow: hidden; }
  .reward-qr img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .reward-col p { margin: 8px 0 0; font-size: 14px; color: var(--fg); }
  .foot-note { color: var(--muted); font-size: 13px; margin-top: 28px; text-align: center; }
</style>
